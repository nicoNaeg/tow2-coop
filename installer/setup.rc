// The installer's window, manifest and payload (the mod's two DLLs, built just before).
#include <windows.h>
#include "resource.h"
#include "version.h"

1 RT_MANIFEST "installer/setup.manifest"
IDR_DSOUND RCDATA "bin/dsound.dll"
IDR_CORE RCDATA "bin/core/tow2coop.dll"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TOW2_VERSION_NUM
PRODUCTVERSION TOW2_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "The Outer Worlds 2 co-op setup"
      VALUE "ProductName", "tow2-coop"
      VALUE "ProductVersion", TOW2_VERSION
      VALUE "FileVersion", TOW2_VERSION
      VALUE "OriginalFilename", "tow2coop-setup.exe"
      VALUE "LegalCopyright", "MIT license"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_MAIN DIALOGEX 0, 0, 320, 214
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "The Outer Worlds 2 co-op"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
  LTEXT "", IDC_TITLE, 10, 8, 300, 12
  LTEXT "", IDC_GAME_LABEL, 10, 25, 300, 9
  EDITTEXT IDC_GAME, 10, 36, 240, 13, ES_AUTOHSCROLL | ES_READONLY
  PUSHBUTTON "", IDC_BROWSE, 255, 35, 55, 15
  LTEXT "", IDC_STATUS, 10, 53, 300, 20
  GROUPBOX "", IDC_GROUP, 10, 75, 300, 64
  AUTORADIOBUTTON "", IDC_STEAM, 18, 88, 286, 10, WS_GROUP | WS_TABSTOP
  AUTORADIOBUTTON "", IDC_DIRECT, 18, 102, 286, 10
  COMBOBOX IDC_ROLE, 30, 116, 62, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL | WS_GROUP
  LTEXT "", IDC_PEER_LABEL, 98, 118, 40, 9
  EDITTEXT IDC_PEER, 139, 116, 74, 13, ES_AUTOHSCROLL
  LTEXT "", IDC_KEY_LABEL, 218, 118, 18, 9
  EDITTEXT IDC_KEY, 236, 116, 66, 13, ES_AUTOHSCROLL
  EDITTEXT IDC_RESULT, 10, 145, 300, 42, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
  DEFPUSHBUTTON "", IDC_INSTALL, 10, 193, 80, 15
  PUSHBUTTON "", IDC_UNINSTALL, 95, 193, 70, 15
  PUSHBUTTON "", IDCANCEL, 240, 193, 70, 15
END
